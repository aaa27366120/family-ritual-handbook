      "term": "飯春",
      "alias": [
        "春花"
      ],
      "meaning": "一種插在飯上面的春仔花。文中「插春花」即是插上這種花。"
    },
    {
      "term": "米栳",
      "alias": [],
      "meaning": "指米粩，是一種乾糧。"
    },
    {
      "term": "乾糧",
      "alias": [],
      "meaning": "一般乾糧的統稱。"
    },
    {
      "term": "裝衣",
      "alias": [
        "經衣"
      ],
      "meaning": "一種金紙，也叫做經衣。"
    }
  ],
